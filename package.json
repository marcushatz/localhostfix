{
  "name": "localhostfix",
  "version": "0.1.0",
  "description": "Open-source CLI for when Claude Code or another coding agent cannot properly see your localhost frontend through Playwright. Fixes common setup failures, diagnoses application failures with evidence, and verifies that the real frontend renders again.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "prepack": "npm run build"
  },
  "keywords": [
    "cli",
    "devtools",
    "playwright",
    "claude-code",
    "coding-agents",
    "localhost",
    "frontend",
    "screenshot",
    "debugging",
    "dev-server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcushatz/localhostfix.git"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "localhostfix": "./dist/cli/main.js"
  }
}
